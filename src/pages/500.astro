---
import Layout from "../layouts/Layout.astro";
import { House, ArrowLeft } from "@lucide/astro";

interface Props {
  error?: unknown;
}

const { error } = Astro.props;

const displayMessage =
  "Une erreur inattendue s'est produite lors du traitement de votre requête.";

if (error instanceof Error) {
  console.error("500 Server Error:", {
    message: error.message,
    stack: error.stack,
    timestamp: new Date().toISOString(),
  });
}
---

<Layout
  title="500 - Erreur serveur | GrouBot"
  description="Une erreur s'est produite lors du traitement de votre requête."
>
  <div class="min-h-screen flex items-center justify-center px-4 py-20">
    <div class="text-center max-w-2xl mx-auto">
      <h1 class="text-9xl font-bold text-error mb-4 animate-pulse">500</h1>

      <h2 class="text-4xl font-bold mb-4">Erreur serveur</h2>

      <p class="text-xl mb-8 text-base-content/70">
        {displayMessage}
        <br />
        Veuillez réessayer plus tard.
      </p>

      <div class="divider"></div>

      <div class="flex gap-4 justify-center flex-wrap mt-8">
        <a href="/" class="btn btn-primary gap-2">
          <House class="size-5" />
          Accueil
        </a>
        <button onclick="history.back()" class="btn btn-outline gap-2">
          <ArrowLeft class="size-5" />
          Retour
        </button>
      </div>

      <div class="flex justify-center gap-2 mt-12">
        <div class="flex gap-3 justify-center flex-wrap text-sm">
          <a href="/blog" class="link link-hover">Blog</a>
          <span class="text-base-content/30">&bull;</span>
          <a href="/#about" class="link link-hover">À propos</a>
        </div>
      </div>
    </div>
  </div>
</Layout>
