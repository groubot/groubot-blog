---
import Layout from "../layouts/Layout.astro";
import { House } from "@lucide/astro";
---

<Layout
  title="404 - Page introuvable | GrouBot"
  description="La page que vous recherchez n'existe pas."
>
  <div class="min-h-screen flex items-center justify-center px-4 py-20">
    <div class="text-center max-w-2xl mx-auto">
      <h1 class="text-9xl font-bold text-primary mb-4 animate-pulse">404</h1>

      <h2 class="text-4xl font-bold mb-4">Page introuvable</h2>

      <p class="text-xl mb-8 text-base-content/70">
        Oups ! La page que vous recherchez n'existe pas ou a été déplacée.
      </p>

      <div class="divider"></div>

      <div class="flex gap-4 justify-center flex-wrap mt-8">
        <a href="/" class="btn btn-primary gap-2">
          <House class="size-5" />
          Accueil
        </a>
      </div>

      <div class="flex justify-center gap-2 mt-12">
        <p class="text-sm text-base-content/60 mb-4">
          Vous cherchez peut-être :
        </p>
        <div class="flex gap-3 justify-center flex-wrap text-sm">
          <a href="/blog" class="link link-hover">Blog</a>
          <span class="text-base-content/30">&bull;</span>
          <a href="/#about" class="link link-hover">À propos</a>
        </div>
      </div>
    </div>
  </div>
</Layout>
